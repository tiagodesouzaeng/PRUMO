# Frontend
VITE_PRUMO_API_URL=http://127.0.0.1:8787
VITE_PRUMO_AUTH_URL=
# Somente desenvolvimento local; não definir em produção.
VITE_PRUMO_DEV_USER=
VITE_PRUMO_TENANT_ID=
VITE_PRUMO_TEAM_ID=

# API
PRUMO_API_HOST=127.0.0.1
PRUMO_API_PORT=8787
PRUMO_CORS_ORIGINS=http://127.0.0.1:4173,http://localhost:4173

# Desenvolvimento local temporário
PRUMO_API_STORAGE=memory
PRUMO_DEV_IDENTITY=true

# PostgreSQL corporativo
# PRUMO_API_STORAGE=postgres
# PRUMO_DATABASE_URL=postgresql://usuario:senha@host:5432/prumo
# PRUMO_MIGRATION_DATABASE_URL=postgresql://migrador:senha@host:5432/prumo
# PRUMO_DATABASE_SSL=true

# Provedor OIDC obrigatório em produção
PRUMO_OIDC_ISSUER=
PRUMO_OIDC_AUDIENCE=
