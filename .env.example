# Frontend
VITE_PRUMO_API_URL=http://127.0.0.1:8787
VITE_PRUMO_AUTH_URL=
# Somente desenvolvimento local; não definir em produção.
VITE_PRUMO_DEV_USER=
VITE_PRUMO_TENANT_ID=
VITE_PRUMO_TEAM_ID=
VITE_PRUMO_REQUIRE_AUTH=true

# API
PRUMO_API_HOST=127.0.0.1
PRUMO_API_PORT=8787
PRUMO_CORS_ORIGINS=http://127.0.0.1:4173,http://localhost:4173

# Desenvolvimento local temporário
PRUMO_API_STORAGE=memory
PRUMO_DEV_IDENTITY=true

# Conta administrativa de contingência. Gere hash, salt e segredo fora do repositório.
# Nunca informe a senha em texto aberto nestas variáveis.
PRUMO_LOCAL_ADMIN_ENABLED=false
PRUMO_LOCAL_ADMIN_USER=admin
PRUMO_LOCAL_ADMIN_SUBJECT=local-admin
PRUMO_LOCAL_ADMIN_PASSWORD_HASH=
PRUMO_LOCAL_ADMIN_PASSWORD_SALT=
PRUMO_LOCAL_ADMIN_SESSION_SECRET=
PRUMO_LOCAL_ADMIN_SESSION_MINUTES=30

# PostgreSQL corporativo
# PRUMO_API_STORAGE=postgres
# PRUMO_DATABASE_URL=postgresql://usuario:senha@host:5432/prumo
# PRUMO_MIGRATION_DATABASE_URL=postgresql://migrador:senha@host:5432/prumo
# PRUMO_BACKUP_DATABASE_URL=postgresql://backup:senha@host:5432/prumo
# PRUMO_BACKUP_DIR=outputs/backups
# PRUMO_RESTORE_TEST_DATABASE_URL=postgresql://restaurador:senha@host:5432/prumo_restore_test
# PRUMO_RESTORE_TEST_CONFIRM=RECRIAR_BANCO_DE_TESTE
# PRUMO_ADMIN_DATABASE_URL=postgresql://prumo_devops:senha@host:5432/postgres
# PRUMO_DATABASE_SSL=true

# Provedor OIDC obrigatório em produção
PRUMO_OIDC_ISSUER=
PRUMO_OIDC_AUDIENCE=
PRUMO_OIDC_JWKS_URL=

# Storage de objetos S3 compatível, obrigatório em produção.
# As credenciais podem ser omitidas quando a infraestrutura fornece uma role IAM.
PRUMO_OBJECT_STORAGE_PROVIDER=disabled
PRUMO_OBJECT_STORAGE_REGION=
PRUMO_OBJECT_STORAGE_BUCKET=
PRUMO_OBJECT_STORAGE_ENDPOINT=
PRUMO_OBJECT_STORAGE_FORCE_PATH_STYLE=false
PRUMO_OBJECT_STORAGE_ACCESS_KEY_ID=
PRUMO_OBJECT_STORAGE_SECRET_ACCESS_KEY=
PRUMO_OBJECT_STORAGE_SESSION_TOKEN=
PRUMO_OBJECT_STORAGE_SIGNED_URL_TTL=300
